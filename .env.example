# ============================================================
# 银行授信尽调系统 - 环境变量配置
# 复制为 .env 后修改以下配置
# ============================================================

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/credit_db

# Redis
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=change-me-in-production-use-random-32-byte-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# QCC API (企查查)
QCC_API_KEY=
QCC_API_BASE_URL=https://api.qcc.com

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Debug
DEBUG=false

# CORS (comma-separated origins)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:80"]

# File upload
MAX_FILE_SIZE=52428800
UPLOAD_DIR=uploads
