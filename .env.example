# Credit Due Diligence System - Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ── Security (CRITICAL) ────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generate-a-random-32-char-min-key-here
POSTGRES_PASSWORD=generate-a-strong-postgres-password-here

# ── Database ───────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:${POSTGRES_PASSWORD}@postgres:5432/credit_db

# ── Redis ──────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Security Settings ──────────────────────────────────────────────
# MUST be false in production
DEBUG=false
ENABLE_DEMO_MODE=false

# CORS: comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── QCC API ────────────────────────────────────────────────────────
QCC_API_KEY=your-qcc-api-key
QCC_API_BASE_URL=https://api.qcc.com

# ── Celery ─────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
